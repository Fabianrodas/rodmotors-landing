---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/brand/logo.png';
import Cta from './ui/Cta.astro';
import { NAV, type PageKey } from '../data/nav';

interface Props {
  active?: PageKey;
}
const { active } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-claro/8 bg-fondo">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-8 px-5 lg:h-20 lg:px-20">
    <a href="/" class="block shrink-0">
      <Image src={logo} alt="Rod Motors, taller automotriz, inicio" height={108} class="h-11 w-auto lg:h-[54px]" loading="eager" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1.5 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? 'page' : undefined}
            class="inline-flex min-h-11 items-center px-3.5 text-[15px] font-medium text-apagado hover:text-claro aria-[current=page]:font-bold aria-[current=page]:text-claro aria-[current=page]:shadow-[inset_0_-3px_0_var(--amarillo)]"
          >
            {item.label}
          </a>
        ))
      }
      <span class="w-5" aria-hidden="true"></span>
      <Cta size="s" />
    </nav>

    <button
      type="button"
      class="flex size-12 items-center justify-center border border-claro/22 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-boton
    >
      <Icon name="ph:list" class="size-6" aria-hidden="true" data-menu-icono-abrir />
      <Icon name="ph:x" class="hidden size-6" aria-hidden="true" data-menu-icono-cerrar />
    </button>
  </div>

  <div id="menu-movil" class="absolute inset-x-0 top-16 hidden border-b border-claro/12 bg-profundo shadow-[0_24px_50px_rgb(0_0_0/0.5)] lg:hidden" data-menu>
    <nav aria-label="Principal, celular">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? 'page' : undefined}
            class="flex min-h-[60px] items-center justify-between border-b border-claro/10 px-5 text-xl font-semibold text-claro aria-[current=page]:font-extrabold aria-[current=page]:text-amarillo"
          >
            {item.label}
            <Icon name="ph:caret-right" class="size-[18px] text-etiqueta" aria-hidden="true" />
          </a>
        ))
      }
    </nav>
    <div class="p-5"><Cta size="m" full /></div>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    if (!boton || !menu) return;
    menu.classList.toggle('hidden', !open);
    boton.setAttribute('aria-expanded', String(open));
    boton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    boton.querySelector('[data-menu-icono-abrir]')?.classList.toggle('hidden', open);
    boton.querySelector('[data-menu-icono-cerrar]')?.classList.toggle('hidden', !open);
  };
  boton?.addEventListener('click', () => setOpen(boton.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      boton.focus();
    }
  });
</script>
