---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const [mantenimiento, motor, tren] = site.serviceGroups;
const vehicleIcons = ['ph:car-profile', 'ph:van', 'ph:truck'];
---

<!--
  Bento de cuatro celdas para cuatro contenidos exactos: los tres grupos de servicio
  más la celda de tamaños. Antes eran cinco, con una ranura de foto alta (3 columnas
  por 2 filas) en el medio. Esa ranura salió: mientras no haya fotos reales del taller,
  el espacio lo ocupa contenido, no una ilustración de relleno (spec 7.6). La celda
  ámbar se mudó a ese hueco alto, que le calza mejor a tres tipos apilados que la
  celda ancha y baja donde estaba.
-->
<section id="servicios" class="mx-auto max-w-[1400px] px-4 py-16">
  <h2 class="display max-w-[20ch] text-3xl md:text-4xl">Lo que hacemos en el taller</h2>

  <div class="mt-8 grid gap-4 md:grid-cols-12">
    <article class="bg-surface p-6 md:col-span-5">
      <h3 class="flex items-center gap-3 text-xl font-semibold">
        <Icon name={mantenimiento.icon} class="size-6 text-muted" aria-hidden="true" />
        {mantenimiento.title}
      </h3>
      <ul class="mt-4 grid gap-4">
        {mantenimiento.services.map((service) => (
          <li>
            <p class="font-medium">{service.name}</p>
            <p class="text-muted">{service.summary}</p>
          </li>
        ))}
      </ul>
    </article>

    <article class="bg-surface p-6 md:col-span-4">
      <h3 class="flex items-center gap-3 text-xl font-semibold">
        <Icon name={motor.icon} class="size-6 text-muted" aria-hidden="true" />
        {motor.title}
      </h3>
      <ul class="mt-4 grid gap-4">
        {motor.services.map((service) => (
          <li>
            <p class="font-medium">{service.name}</p>
            <p class="text-muted">{service.summary}</p>
          </li>
        ))}
      </ul>
    </article>

    <article class="flex flex-col border border-accent bg-accent/10 p-6 md:col-span-3 md:row-span-2">
      <h3 class="text-xl font-semibold">Atendemos todos los tamaños</h3>
      <ul class="mt-6 grid flex-1 content-center gap-8">
        {site.vehicleTypes.map((type, index) => (
          <li class="flex items-center gap-3 text-lg">
            <Icon name={vehicleIcons[index]} class="size-8 shrink-0 text-accent-strong" aria-hidden="true" />
            {type}
          </li>
        ))}
      </ul>
    </article>

    <article class="bg-surface p-6 md:col-span-9">
      <h3 class="flex items-center gap-3 text-xl font-semibold">
        <Icon name={tren.icon} class="size-6 text-muted" aria-hidden="true" />
        {tren.title}
      </h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {tren.services.map((service) => (
          <li>
            <p class="font-medium">{service.name}</p>
            <p class="text-muted">{service.summary}</p>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
