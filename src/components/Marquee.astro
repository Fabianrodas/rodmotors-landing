---
const items = ['Livianos', 'Semipesados', 'Pesados', 'Todas las marcas', 'Diagnóstico computarizado', 'Alineación computarizada'];
---

<div class="flex h-[52px] items-center overflow-hidden bg-marca lg:h-[68px]" aria-hidden="true">
  <div class="rm-march flex items-center text-base font-extrabold whitespace-nowrap text-claro lg:text-xl">
    {
      [0, 1].map(() =>
        items.map((item) => (
          <>
            <span class="px-[18px] lg:px-7">{item}</span>
            <span class="text-amarillo">/</span>
          </>
        )),
      )
    }
  </div>
</div>
