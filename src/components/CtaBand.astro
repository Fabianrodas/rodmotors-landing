---
/** Cierre de página. A la izquierda, la vía urgente (estado y llamada); en la diagonal, la acción principal. */
import { Icon } from 'astro-icon/components';
import Diagonal from './ui/Diagonal.astro';
import Cta from './ui/Cta.astro';
import StatusChip from './ui/StatusChip.astro';
import { site } from '../data/site';
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---

<section class="relative overflow-hidden bg-marca lg:bg-fondo">
  <Diagonal class="absolute! inset-y-0 right-0 hidden w-[78%] lg:block" decorative />
  <span class="absolute top-0 left-0 h-[5px] w-[42%] bg-amarillo lg:hidden" aria-hidden="true"></span>
  <div class="relative flex flex-col lg:h-[440px] lg:flex-row">
    <div class="order-2 flex flex-col gap-4 border-t border-claro/14 px-5 py-8 lg:order-none lg:w-[30%] lg:justify-center lg:border-0 lg:py-0 lg:pl-20">
      <p class="font-mono text-[13px] tracking-[0.06em] text-apagado lg:text-etiqueta">¿Es urgente?</p>
      <div><StatusChip size="m" /></div>
      <a href={`tel:${site.phoneE164}`} class="inline-flex min-h-12 items-center gap-3 text-xl font-extrabold numeric hover:text-amarillo lg:text-2xl">
        <Icon name="ph:phone" class="size-6 text-amarillo" aria-hidden="true" />{site.phoneDisplay}
      </a>
    </div>
    <div class="flex flex-col gap-[18px] px-5 py-[72px] pb-10 lg:ml-auto lg:w-[70%] lg:justify-center lg:gap-[22px] lg:py-0 lg:pr-20 lg:pl-[18%]">
      <h2 class="titulo text-[34px] lg:text-[56px]">{title}</h2>
      <p class="max-w-[40ch] text-base leading-relaxed text-claro lg:text-[19px]">{text}</p>
      <div><Cta size="l" class="w-full lg:w-auto" /></div>
    </div>
  </div>
</section>
