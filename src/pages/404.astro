---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Cta from '../components/ui/Cta.astro';
import { site } from '../data/site';
---

<Base noindex title={`Página no encontrada, ${site.name}`} description="La página que buscas no existe. Vuelve al inicio para ver servicios, horario y ubicación del taller.">
  <Header />
  <main id="contenido" class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-[1280px] flex-col justify-center gap-6 px-5 py-24 lg:px-20">
    <p class="font-mono text-[13px] tracking-[0.06em] text-amarillo">Error 404</p>
    <h1 class="display text-[clamp(2.25rem,5vw,3.5rem)]">Esta página no existe</h1>
    <p class="max-w-[50ch] text-base leading-relaxed text-apagado lg:text-lg">Puede que el enlace sea viejo. Desde el inicio encuentras servicios, horario y cómo llegar al taller.</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/" class="inline-flex min-h-[52px] items-center justify-center bg-amarillo px-7 text-base font-bold text-tinta">Ir al inicio</a>
      <Cta />
    </div>
  </main>
  <Footer />
  <MobileBar />
</Base>
