---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Marquee from '../components/Marquee.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import BookingForm from '../components/BookingForm.astro';
import Diagonal from '../components/ui/Diagonal.astro';
import Cta from '../components/ui/Cta.astro';
import TextLink from '../components/ui/TextLink.astro';
import StatusChip from '../components/ui/StatusChip.astro';
import Photo from '../components/ui/Photo.astro';
import Hours from '../components/ui/Hours.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import logo from '../assets/brand/logo.png';
import { site } from '../data/site';
---

<Base title="Rod Motors, taller automotriz en Samanes 5, Guayaquil">
  <Header active="inicio" />
  <main id="contenido">
    <section class="relative overflow-hidden bg-fondo lg:h-[720px]">
      <div class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(115deg,#0c1c44_0%,#0a1633_55%,#070f24_100%)] lg:block" aria-hidden="true"></div>
      <div class="relative z-10 flex flex-col gap-[18px] px-5 pt-8 lg:w-[52%] lg:gap-7 lg:pt-24 lg:pl-20">
        <p class="rm-r1 font-mono text-[13px] tracking-[0.06em] text-amarillo lg:text-sm">Taller automotriz en Guayaquil</p>
        <h1 class="rm-r2 display text-[clamp(2.75rem,6.1vw,5.5rem)]">Tu taller en<br />Samanes 5</h1>
        <p class="rm-r3 max-w-[36ch] text-base leading-relaxed text-apagado lg:text-xl">
          Diagnóstico computarizado, mantenimiento y reparación para livianos, semipesados y pesados. Todas las marcas.
        </p>
        <div class="rm-r3 mt-2 flex flex-col gap-2 lg:mt-3 lg:flex-row lg:items-center lg:gap-8">
          <Cta size="l" class="w-full lg:w-auto" />
          <div class="flex justify-center lg:block"><TextLink href="/ubicacion">Cómo llegar</TextLink></div>
        </div>
      </div>
      <Diagonal class="mt-7 h-[400px] lg:absolute! lg:inset-y-0 lg:right-0 lg:mt-0 lg:h-auto lg:w-[48%]">
        <div class="flex flex-1 flex-col items-center justify-start gap-[22px] pt-[52px] lg:justify-center lg:gap-10 lg:pt-0 lg:pl-[20%]">
          <Image src={logo} alt="" aria-hidden="true" width={580} class="rm-pop w-[124px] drop-shadow-[0_18px_30px_rgb(5_11_26/0.5)] lg:w-[290px]" loading="eager" fetchpriority="high" />
          <div class="rm-r3"><StatusChip /></div>
        </div>
      </Diagonal>
    </section>

    <Marquee />

    <section id="servicios" class="bg-fondo px-5 py-[72px] lg:px-20 lg:py-28">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-8 lg:gap-14">
        <div class="flex max-w-[760px] flex-col gap-3.5 lg:gap-5">
          <h2 class="titulo text-[38px] lg:text-[64px]">Lo que hacemos en el taller</h2>
          <p class="text-base leading-relaxed text-apagado lg:text-[19px]">Diez servicios en tres frentes. Si no sabes qué tiene tu vehículo, empezamos por el diagnóstico.</p>
        </div>
        <ServiceTabs />
      </div>
    </section>

    <section class="overflow-hidden bg-marca px-5 py-16 lg:px-20 lg:py-[104px]">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-6 lg:gap-9">
        <h2 class="rm-kin text-[clamp(2.875rem,10vw,9.375rem)] leading-[0.85] font-black tracking-[-0.04em] whitespace-nowrap">DIAGNÓSTICO</h2>
        <div class="rm-draw h-[3px] bg-amarillo" aria-hidden="true"></div>
        <div class="flex items-center gap-5">
          <Icon name="ph:scan" class="hidden size-10 shrink-0 text-amarillo lg:block" aria-hidden="true" />
          <p class="max-w-[58ch] text-[17px] leading-relaxed text-claro lg:text-[21px]">
            Escaneamos el sistema electrónico y mecánico para encontrar el origen exacto de la falla, antes de tocar una pieza.
          </p>
        </div>
      </div>
    </section>

    <section id="taller" class="bg-fondo px-5 py-[72px] lg:px-20 lg:py-28">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-8 lg:gap-14">
        <div class="flex max-w-[820px] flex-col gap-3.5 lg:gap-5">
          <h2 class="titulo text-[38px] lg:text-[64px]">Equipos y bahías para trabajo pesado</h2>
          <p class="text-base leading-relaxed text-apagado lg:text-[19px]">Mecánica preventiva y correctiva con escáner y alineadora computarizada.</p>
          <div><TextLink href="/acerca-de">Conoce el taller</TextLink></div>
        </div>
        <div class="grid gap-3.5 lg:auto-rows-[300px] lg:grid-cols-12 lg:gap-6">
          <Photo name="bahia-elevador" class="h-[220px] lg:col-span-7 lg:h-auto" sizes="(min-width: 1024px) 58vw, 100vw" />
          <div class="order-first flex flex-col justify-between gap-4 bg-marca p-7 lg:order-none lg:col-span-5 lg:p-10">
            <p class="hidden text-[17px] text-apagado lg:block">Trabajando en Samanes 5</p>
            <div class="flex items-end justify-between gap-4 lg:block">
              <p class="text-[96px] leading-[0.85] font-black tracking-[-0.05em] text-amarillo numeric lg:text-[112px]">{site.yearsExperience}+</p>
              <p class="text-right text-[17px] leading-snug lg:mt-3.5 lg:text-left lg:text-[26px] lg:font-bold">
                años de oficio<span class="block text-apagado lg:hidden">en Samanes 5</span>
              </p>
            </div>
          </div>
          <div class="flex flex-col justify-between bg-elevada p-6 lg:col-span-5 lg:p-10">
            <p class="mb-2 text-[22px] font-extrabold lg:mb-0 lg:text-[26px]">Equipos del taller</p>
            <ul>
              {
                site.equipment.map((e) => (
                  <li class="flex items-center gap-4 border-t border-claro/12 py-3.5 lg:py-4">
                    <Icon name={e.icon} class="size-6 shrink-0 text-amarillo lg:size-[26px]" aria-hidden="true" />
                    <span class="text-base font-semibold lg:text-lg">{e.name}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <Photo name="camion-bahia" class="h-[220px] lg:col-span-7 lg:h-auto" sizes="(min-width: 1024px) 58vw, 100vw" />
        </div>
      </div>
    </section>

    <BookingForm />

    <section id="ubicacion" class="bg-fondo px-5 py-[72px] lg:px-20 lg:py-28">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-[22px] lg:grid lg:grid-cols-12 lg:gap-6">
        <div class="flex flex-col gap-[22px] lg:col-span-5 lg:gap-6 lg:pr-12">
          <h2 class="titulo text-[38px] lg:text-[64px]">Dónde estamos</h2>
          <div>
            <p class="mb-1.5 text-lg font-semibold lg:text-xl">{site.address.street}</p>
            <p class="text-[15px] text-apagado lg:text-[17px]">{site.address.reference}</p>
          </div>
          <MapFacade class="h-[240px] lg:hidden" />
          <Hours />
          <div><TextLink href="/ubicacion">Ver cómo llegar</TextLink></div>
        </div>
        <MapFacade class="hidden min-h-[480px] lg:col-span-7 lg:block" />
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>
