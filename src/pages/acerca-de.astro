---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CtaBand from '../components/CtaBand.astro';
import Diagonal from '../components/ui/Diagonal.astro';
import TextLink from '../components/ui/TextLink.astro';
import Photo from '../components/ui/Photo.astro';
import { site } from '../data/site';
---

<Base
  title="Acerca de, Rod Motors"
  description={`Rod Motors, antes ${site.legacyName}, más de ${site.yearsExperience} años como taller automotriz en Samanes 5, Guayaquil.`}
>
  <Header active="acerca" />
  <main id="contenido">
    <section class="relative overflow-hidden bg-fondo">
      <div class="relative flex flex-col gap-[18px] px-5 pt-10 lg:w-[52%] lg:gap-7 lg:pt-24 lg:pb-28 lg:pl-20">
        <p class="rm-r1 font-mono text-[13px] tracking-[0.06em] text-amarillo lg:text-sm">Acerca de</p>
        <h1 class="rm-r2 display text-[clamp(2.625rem,5.6vw,5.25rem)]">Más de {site.yearsExperience} años<br />en Samanes 5</h1>
        <p class="rm-r3 max-w-[36ch] text-base leading-relaxed text-apagado lg:text-xl">
          Antes nos conocías como {site.legacyName}. Hoy somos {site.name}, en la misma esquina de siempre.
        </p>
        <div class="rm-r3"><TextLink href="/servicios">Ver servicios</TextLink></div>
      </div>
      <Diagonal class="-mx-5 mt-3 h-[300px] lg:absolute! lg:inset-y-0 lg:right-0 lg:mx-0 lg:mt-0 lg:h-auto lg:w-[48%]">
        <Photo name="equipo" class="h-full w-full lg:pl-[18%]" sizes="(min-width: 1024px) 48vw, 100vw" />
      </Diagonal>
    </section>

    <section class="bg-profundo px-5 py-14 lg:px-20 lg:py-32">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-6">
        <ol class="order-2 lg:order-none lg:col-span-4">
          {
            site.milestones.map((m) => (
              <li class="relative border-l-[3px] border-amarillo/40 pb-8 pl-6 last:pb-0">
                <span class="absolute top-1 -left-[10px] size-[17px] bg-amarillo" aria-hidden="true" />
                <p class="mb-1.5 font-mono text-[15px] text-amarillo">{m.year}</p>
                <p class="text-[17px] leading-relaxed lg:text-lg">
                  {m.text.startsWith('[') ? <span class="font-mono text-[0.85em] text-amarillo">{m.text}</span> : m.text}
                </p>
              </li>
            ))
          }
        </ol>
        <div class="flex flex-col gap-5 lg:col-span-7 lg:col-start-6 lg:gap-6">
          <h2 class="titulo text-[32px] lg:text-[56px]">De {site.legacyName} a {site.name}</h2>
          {
            site.story.map((paragraph) => (
              <p class="text-[17px] leading-relaxed text-apagado lg:text-xl">
                {paragraph.split(/(\[[^\]]+\])/g).map((part) => (part.startsWith('[') ? <span class="font-mono text-[0.85em] text-amarillo">{part}</span> : part))}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-fondo px-5 py-14 lg:px-20 lg:py-28">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-3.5 lg:gap-12">
        <h2 class="titulo text-[32px] lg:text-[64px]">El taller por dentro</h2>
        <div class="grid grid-cols-2 gap-3.5 lg:auto-rows-[320px] lg:grid-cols-12 lg:gap-6">
          <Photo name="galeria-bahias" class="col-span-2 h-[240px] lg:col-span-7 lg:h-auto" sizes="(min-width: 1024px) 58vw, 100vw" />
          <Photo name="tecnico-cliente" class="col-span-2 h-[220px] lg:col-span-5 lg:row-span-2 lg:h-auto" sizes="(min-width: 1024px) 40vw, 100vw" />
          <Photo name="galeria-alineadora" class="h-[180px] lg:col-span-4 lg:h-auto" sizes="(min-width: 1024px) 33vw, 50vw" />
          <Photo name="galeria-herramientas" class="h-[180px] lg:col-span-3 lg:h-auto" sizes="(min-width: 1024px) 25vw, 50vw" />
        </div>
      </div>
    </section>

    <CtaBand title="Trae tu vehículo" text="Escríbenos con el vehículo y el servicio, y te confirmamos el turno." />
  </main>
  <Footer />
  <MobileBar />
</Base>
